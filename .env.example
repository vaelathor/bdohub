# OCR.space API keys (required for CP module OCR features)
# Get yours at: https://ocr.space/ocrapi
#
# As chaves são tentadas em cadeia: a principal primeiro; se falhar,
# o app mostra um aviso discreto e tenta as reservas na ordem.
OCR_SPACE_API_KEY=your_api_key_here
# Chaves reserva (opcional): descomente para adicionar mais tentativas
#OCR_SPACE_API_KEY_2=your_second_api_key_here
#OCR_SPACE_API_KEY_3=your_third_api_key_here
